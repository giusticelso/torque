# Configuracao do banco de dados MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=oficina

# Porta onde a API vai rodar
PORT=3000

# Segredo usado para gerar e validar o token JWT [RN10]
JWT_SECRET=segredo-da-oficina

# Chave e IV usados para criptografar o CPF [RN03]
# A chave precisa ter 32 caracteres (AES-256) e o IV precisa ter 16 caracteres
CRIPTO_CHAVE=12345678901234567890123456789012
CRIPTO_IV=1234567890123456
